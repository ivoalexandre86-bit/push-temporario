PORT=4000
NODE_ENV=development

# Este sistema roda em DOIS ambientes separados, cada um com seu próprio
# banco de dados (ver "Ambientes: teste local vs produção" no README):
#
#   - PRODUÇÃO: o site publicado no Render, com o Postgres gerenciado do
#     Render (External Database URL do painel do Render).
#   - TESTE/MELHORIA: roda neste computador, com um Postgres LOCAL, gerado
#     automaticamente por `configurar-ambiente-teste.ps1` — não é preciso
#     editar isto manualmente para esse caso.
#
# NUNCA aponte os dois ambientes para o mesmo banco — o objetivo de tê-los
# separados é poder testar/melhorar sem nenhum risco para os dados reais.
DATABASE_URL=postgres://usuario:senha@host.render.com:5432/nome_do_banco

# A maioria dos provedores gerenciados (Render incluso) exige SSL. Troque
# para "disable" quando o Postgres for local (ambiente de teste).
PGSSLMODE=require

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=30m
CORS_ORIGIN=http://localhost:5173
SEED_DEMO_PASSWORD=Mudar@123

# Melhoria 5: reescrever descrição da ação com IA (Claude). Gere uma chave em
# https://console.anthropic.com (Account > API Keys) e cole-a abaixo. Se
# deixar em branco, o botão "Revisão" mostra um aviso e não quebra
# o restante do sistema.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
