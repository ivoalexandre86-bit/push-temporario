PORT=4000
NODE_ENV=development

# Este sistema roda em DOIS ambientes separados, cada um com seu próprio
# banco de dados (ver "Ambientes: teste local vs produção" no README):
#
#   - PRODUÇÃO: o site publicado no Render, com o Postgres gerenciado do
#     Render (External Database URL do painel do Render).
#   - TESTE/MELHORIA: roda neste computador, com um Postgres LOCAL, gerado
#     automaticamente por `configurar-ambiente-teste.ps1` — não é preciso
#     editar isto manualmente para esse caso.
#
# NUNCA aponte os dois ambientes para o mesmo banco — o objetivo de tê-los
# separados é poder testar/melhorar sem nenhum risco para os dados reais.
DATABASE_URL=postgres://usuario:senha@host.render.com:5432/nome_do_banco

# A maioria dos provedores gerenciados (Render incluso) exige SSL. Troque
# para "disable" quando o Postgres for local (ambiente de teste).
PGSSLMODE=require

# Segredo de assinatura das sessões. OBRIGATÓRIO em produção: o servidor não
# inicia com NODE_ENV=production se estiver vazio, curto (< 32 caracteres) ou
# igual a um valor de exemplo. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Em desenvolvimento, se ficar vazio, usa um segredo local inseguro.
JWT_SECRET=
ACCESS_TOKEN_TTL=30m
CORS_ORIGIN=http://localhost:5173

# Contas de demonstração (admin@projetos.local etc., criadas por `npm run seed`).
# - Desenvolvimento/teste: se SEED_DEMO_PASSWORD ficar vazio, usa a senha
#   padrão de desenvolvimento (exibida na tela de login só fora de produção).
# - Produção: o seed NÃO cria essas contas e elas NÃO conseguem entrar, a menos
#   que ALLOW_DEMO_ACCOUNTS=true (seed) / ALLOW_DEMO_LOGIN=true (login) sejam
#   definidos explicitamente. Não há senha padrão em produção.
SEED_DEMO_PASSWORD=
# ALLOW_DEMO_ACCOUNTS=false
# ALLOW_DEMO_LOGIN=false

# TEMPORÁRIO: token dos endpoints /api/admin/* (migração única de dados).
# Deixe vazio para desativá-los. Se precisar, use um valor aleatório com 32+
# caracteres e defina-o só no ambiente (painel do Render), nunca em arquivos
# versionados.
# ADMIN_MIGRATE_TOKEN=

# Melhoria 5: reescrever descrição da ação com IA (Claude). Gere uma chave em
# https://console.anthropic.com (Account > API Keys) e cole-a abaixo. Se
# deixar em branco, o botão "Revisão" mostra um aviso e não quebra
# o restante do sistema.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
