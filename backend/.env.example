PORT=4000
NODE_ENV=development

# Banco de dados PostgreSQL COMPARTILHADO (o mesmo banco usado pelo site
# publicado no Render). Copie a "External Database URL" do painel do Render
# (Dashboard > seu banco Postgres > Connect) e cole abaixo. NÃO use um
# banco local diferente aqui — este notebook e o site na web devem apontar
# para o MESMO banco, senão os dados ficam dessincronizados.
DATABASE_URL=postgres://usuario:senha@host.render.com:5432/nome_do_banco

# A maioria dos provedores gerenciados (Render incluso) exige SSL. Só troque
# para "disable" se estiver rodando um Postgres local (ex.: para testes).
PGSSLMODE=require

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=30m
CORS_ORIGIN=http://localhost:5173
SEED_DEMO_PASSWORD=Mudar@123
